<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A watch-only wallet still needs the network to watch the chain. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ asks before an app may post a notification. Gerfaut
         only asks once the user turns on the new-transaction notice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app lock may be opened by the phone's own prompt when the
         user turns that on; Gerfaut never sees the biometric itself. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The camera is used for one thing: scanning a descriptor, xpub,
         or address QR code on the add-wallet screen. Nothing is
         recorded and no image leaves the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Plugins merge permissions Gerfaut has no use for: the camera
         plugin brings the microphone (no sound is ever captured), the
         file plugins bring legacy external storage (files are opened
         and shared through the system picker). A wallet that promises
         to send nothing out cannot ask for a microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- No copy of Gerfaut's data leaves the phone by way of the system.
         The vault is opened by a key the Android Keystore holds and never
         releases, so a vault carried to another device lands there as a
         file nobody can open. allowBackup stops the cloud copy on every
         version; fullBackupContent says the same to Android 6 through 11,
         which read it instead; dataExtractionRules covers Android 12 and
         later, where a device-to-device transfer would otherwise still
         take the files. Wallets move by a backup made with Gerfaut, which
         carries its own password. tools:replace keeps that true whatever
         a plugin's own manifest asks for: on these two attributes the
         merger would otherwise stop the build, or take the plugin's word. -->
    <application
        android:label="Gerfaut"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Never reaches an installed app: every build type removes
                 this filter again (src/debug, src/profile, src/release),
                 so the launcher shows one entry, the enabled alias below.
                 The Flutter tool does not need it either. After a build it
                 reads the APK's manifest and starts the first enabled
                 element named activity* that carries MAIN and LAUNCHER,
                 aliases included: the .Launcher alias. So `flutter run`
                 fails only while the device is disguised, when that alias
                 is disabled; the calculator icon opens the app then. The
                 filter stays so this activity reads as what it is, the one
                 launcher target, in the manifest that declares it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The two faces of the app in the launcher, exactly one enabled
             at a time; the activity flips them from the disguise channel.
             On Android 10 and later an app that disables its only launcher
             entry is not gone from the launcher: the system shows a
             synthesized entry, named after the app, that opens its
             settings page. Hiding the icon would still say "Gerfaut", so
             the disguise is another launcher entry, never an absence.
             Launch mode, task affinity and theme come from the target. -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:label="Gerfaut"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Calculator"
            android:targetActivity=".MainActivity"
            android:label="Calculator"
            android:icon="@mipmap/ic_calculator"
            android:roundIcon="@mipmap/ic_calculator"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- The three home-screen widgets. Exported, as the launcher
             delivers APPWIDGET_UPDATE from outside the app; the data
             they draw is only what the app chose to publish for them. -->
        <receiver
            android:name=".PriceWidgetProvider"
            android:label="@string/widget_price_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_price_info" />
        </receiver>
        <receiver
            android:name=".BalanceWidgetProvider"
            android:label="@string/widget_balance_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>
        <receiver
            android:name=".NetworkWidgetProvider"
            android:label="@string/widget_network_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_network_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The one app a subscribe link is handed to. A topic is the
             whole secret of an alert channel, so the intent that carries
             it names its package instead of being offered to whatever
             app declared the ntfy scheme. From Android 11 a package this
             app never asks about is invisible to it, and an installed
             ntfy would look exactly like an absent one. -->
        <package android:name="io.heckel.ntfy" />
    </queries>
</manifest>
