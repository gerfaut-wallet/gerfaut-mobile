<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, Android 8 and up. The launcher masks the outer edges of
     the 108dp square, so the mark lives well inside the safe zone. The
     monochrome layer feeds Android 13 themed icons: same silhouette, tinted
     by the system. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
