<?xml version="1.0" encoding="utf-8"?>
<!-- The price widget: a label, the figure, the change and its time,
     and the credit the source of the price asks for. System font,
     tabular figures; the app writes every value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/price_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_price_label"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Shrinks to the room it has rather than cutting a figure: a cut
         price or height is a wrong one. It takes the height the other
         lines leave, so a low widget, or a large text size, shrinks the
         figure and never pushes the credit under the edge. The smallest
         size is in dp: in sp, the reader's text size would raise it. -->
    <TextView
        android:id="@+id/price_figure"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical|start"
        android:text="@string/widget_placeholder"
        android:contentDescription="@string/widget_placeholder_spoken"
        android:textSize="22sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10dp"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeStepGranularity="1dp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="'tnum'"
        android:letterSpacing="-0.01"
        android:textColor="@color/widget_text"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/price_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/price_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="'tnum'"
            android:textColor="@color/widget_text_muted"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/price_as_of"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="'tnum'"
            android:textColor="@color/widget_text_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- "Powered by CoinGecko" under the price it came with, never cut:
         PriceWidgetProvider sizes it to hold its line at a large text
         size, down to 10dp, the least the CoinGecko terms allow, and
         gives it a second line on a widget too narrow even then. -->
    <TextView
        android:id="@+id/price_credit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:visibility="gone" />
</LinearLayout>
