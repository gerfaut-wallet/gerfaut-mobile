<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later read this file instead of android:allowBackup
     alone. Turning backup off stops the cloud copy, but a device-to-device
     transfer still carries an app's files across unless it is excluded
     here as well.

     Gerfaut's vault must not travel. Its key is held by the Android
     Keystore, which never leaves the phone it was made on: a vault copied
     to another device arrives as a file nobody can open, and the app that
     receives it cannot tell that from a vault whose key was lost. Nor
     should what sits beside it: shared_prefs/ holds the widgets' copy of
     wallet names and balances and the secure storage entry, files/ and
     databases/ the app's own state.

     Android copies an app's data domain by domain, and `root` is the data
     directory minus the folders other domains name: excluding it alone
     still lets files/, databases/ and shared_prefs/ go. So every domain
     is excluded, the device-protected storage ones included, and nothing
     is included: neither path takes anything of Gerfaut's. A backup made
     with Gerfaut is how wallets move. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
