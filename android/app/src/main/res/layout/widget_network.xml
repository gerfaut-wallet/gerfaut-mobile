<?xml version="1.0" encoding="utf-8"?>
<!-- The network widget: the block height as of the last sync, and how
     old that reading is. Top-aligned like the balance card beside it:
     centred, a two-cell card put its title in the middle of nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/network_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_network_label"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/network_height"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_placeholder"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="'tnum'"
        android:letterSpacing="-0.01"
        android:textColor="@color/widget_text"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/network_block_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_block_height_label"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/network_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:fontFeatureSettings="'tnum'"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
