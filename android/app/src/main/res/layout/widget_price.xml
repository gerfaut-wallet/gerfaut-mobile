<?xml version="1.0" encoding="utf-8"?>
<!-- The price widget: a label, the figure, the change and its time.
     System font, tabular figures; the app writes every value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/price_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_price_label"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/price_figure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_placeholder"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="'tnum'"
        android:letterSpacing="-0.01"
        android:textColor="@color/widget_text"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/price_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/price_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="'tnum'"
            android:textColor="@color/widget_text_muted"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/price_as_of"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="'tnum'"
            android:textColor="@color/widget_text_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
