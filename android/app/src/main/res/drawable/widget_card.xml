<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card: surface, hairline border, the corner the system
     rounds to. A card never has a shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke
        android:width="1px"
        android:color="@color/widget_border" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
