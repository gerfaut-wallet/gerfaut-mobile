<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A watch-only wallet still needs the network to watch the chain. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ asks before an app may post a notification. Gerfaut
         only asks once the user turns on the new-transaction notice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live watch, off until the user turns it on in Settings: a
         foreground service keeps one connection open to the server the
         user chose, so a transaction is told within seconds. Its type is
         "special use" because no other type describes it: nothing is
         transferred, no device is connected, no message is relayed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Live watch comes back by itself after a restart of the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Held for a few seconds at a time, while the connection is
         checked from the heartbeat alarm. Never while merely waiting. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets Live watch put Android's own yes-or-no question about
         battery optimisation. Without the exemption Android 12 and later
         will not let a service it killed start again by itself. Asked
         when the user turns Live on, explained first, and refusable. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- To be told when the network changes, so the connection is
         opened again at once instead of at the next heartbeat. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The app lock may be opened by the phone's own prompt when the
         user turns that on; Gerfaut never sees the biometric itself. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The camera is used for one thing: scanning a descriptor, xpub,
         or address QR code on the add-wallet screen. Nothing is
         recorded and no image leaves the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Plugins merge permissions Gerfaut has no use for: the camera
         plugin brings the microphone (no sound is ever captured), the
         file plugins bring legacy external storage (files are opened
         and shared through the system picker). A wallet that promises
         to send nothing out cannot ask for a microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- No copy of Gerfaut's data leaves the phone by way of the system.
         The vault is opened by a key the Android Keystore holds and never
         releases, so a vault carried to another device lands there as a
         file nobody can open. allowBackup stops the cloud copy on every
         version; fullBackupContent says the same to Android 6 through 11,
         which read it instead; dataExtractionRules covers Android 12 and
         later, where a device-to-device transfer would otherwise still
         take the files. Wallets move by a backup made with Gerfaut, which
         carries its own password. tools:replace keeps that true whatever
         a plugin's own manifest asks for: on these two attributes the
         merger would otherwise stop the build, or take the plugin's word. -->
    <application
        android:label="Gerfaut"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Never reaches an installed app: every build type removes
                 this filter again (src/debug, src/profile, src/release),
                 so the launcher shows one entry, the enabled alias below.
                 The Flutter tool does not need it either. After a build it
                 reads the APK's manifest and starts the first enabled
                 element named activity* that carries MAIN and LAUNCHER,
                 aliases included: the .Launcher alias. So `flutter run`
                 fails only while the device is disguised, when that alias
                 is disabled; the calculator icon opens the app then. The
                 filter stays so this activity reads as what it is, the one
                 launcher target, in the manifest that declares it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The two faces of the app in the launcher, exactly one enabled
             at a time; the activity flips them from the disguise channel.
             On Android 10 and later an app that disables its only launcher
             entry is not gone from the launcher: the system shows a
             synthesized entry, named after the app, that opens its
             settings page. Hiding the icon would still say "Gerfaut", so
             the disguise is another launcher entry, never an absence.
             Launch mode, task affinity and theme come from the target. -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:label="Gerfaut"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Calculator"
            android:targetActivity=".MainActivity"
            android:label="Calculator"
            android:icon="@mipmap/ic_calculator"
            android:roundIcon="@mipmap/ic_calculator"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- The three home-screen widgets. Exported, as the launcher
             delivers APPWIDGET_UPDATE from outside the app; the data
             they draw is only what the app chose to publish for them. -->
        <receiver
            android:name=".PriceWidgetProvider"
            android:label="@string/widget_price_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_price_info" />
        </receiver>
        <receiver
            android:name=".BalanceWidgetProvider"
            android:label="@string/widget_balance_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>
        <receiver
            android:name=".NetworkWidgetProvider"
            android:label="@string/widget_network_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_network_info" />
        </receiver>
        <!-- Live watch. Not exported: only this app and the system can
             start it. It runs in the app's own process and must stay
             there: the vault has one owner per process, and a second
             process would overwrite it. stopWithTask is false so that
             swiping the app away does not end the watch. -->
        <service
            android:name=".LiveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one connection open to the Bitcoin server the user chose, so the user is told the moment a transaction touching a watched wallet is broadcast or confirmed. The user turns it on in Settings, a notification shows it is running, and it stops when the user turns it off. The app has no vendor server and no Firebase: only the device knows which addresses are watched." />
        </service>
        <!-- Brings Live watch back after a restart of the phone or an
             update of the app, and receives its heartbeat alarm. Not
             exported: the system reaches it all the same, other apps
             cannot. -->
        <receiver
            android:name=".LiveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The one app a subscribe link is handed to. A topic is the
             whole secret of an alert channel, so the intent that carries
             it names its package instead of being offered to whatever
             app declared the ntfy scheme. From Android 11 a package this
             app never asks about is invisible to it, and an installed
             ntfy would look exactly like an absent one. -->
        <package android:name="io.heckel.ntfy" />
        <!-- Telegram, for the same reason: a start link carries the code
             that links a chat to the account's alerts. -->
        <package android:name="org.telegram.messenger" />
    </queries>
</manifest>
