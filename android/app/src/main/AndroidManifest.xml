<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A watch-only wallet still needs the network to watch the chain. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ asks before an app may post a notification. Gerfaut
         only asks once the user turns on the new-transaction notice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app lock may be opened by the phone's own prompt when the
         user turns that on; Gerfaut never sees the biometric itself. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The camera is used for one thing: scanning a descriptor, xpub,
         or address QR code on the add-wallet screen. Nothing is
         recorded and no image leaves the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Plugins merge permissions Gerfaut has no use for: the camera
         plugin brings the microphone (no sound is ever captured), the
         file plugins bring legacy external storage (files are opened
         and shared through the system picker). A wallet that promises
         to send nothing out cannot ask for a microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <application
        android:label="Gerfaut"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- For the Flutter tool only. It finds the activity to start
                 by this filter and reads <activity> elements, never the
                 aliases below. Every build type removes the filter again
                 (src/debug, src/profile, src/release), so the installed
                 app shows one launcher entry and `flutter run` still
                 knows where to start. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The two faces of the app in the launcher, exactly one enabled
             at a time; the activity flips them from the disguise channel.
             On Android 10 and later an app that disables its only launcher
             entry is not gone from the launcher: the system shows a
             synthesized entry, named after the app, that opens its
             settings page. Hiding the icon would still say "Gerfaut", so
             the disguise is another launcher entry, never an absence.
             Launch mode, task affinity and theme come from the target. -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:label="Gerfaut"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Calculator"
            android:targetActivity=".MainActivity"
            android:label="Calculator"
            android:icon="@mipmap/ic_calculator"
            android:roundIcon="@mipmap/ic_calculator"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- The three home-screen widgets. Exported, as the launcher
             delivers APPWIDGET_UPDATE from outside the app; the data
             they draw is only what the app chose to publish for them. -->
        <receiver
            android:name=".PriceWidgetProvider"
            android:label="@string/widget_price_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_price_info" />
        </receiver>
        <receiver
            android:name=".BalanceWidgetProvider"
            android:label="@string/widget_balance_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>
        <receiver
            android:name=".NetworkWidgetProvider"
            android:label="@string/widget_network_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_network_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
